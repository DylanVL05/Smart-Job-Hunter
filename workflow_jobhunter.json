      "typeVersion": 4.2
    },
    {
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nconst jobs = resp.data || [];\nreturn jobs.map(j => ({\n  json: {\n    title: j.title || '',\n    url: j.url || '',\n    description: (j.description || '').replace(/<[^>]+>/g, ' ').slice(0, 2000),\n    budget: 'No especificado',\n    datePosted: j.created_at ? new Date(j.created_at * 1000).toISOString() : '',\n    source: 'Arbeitnow'\n  }\n}));"
      },
