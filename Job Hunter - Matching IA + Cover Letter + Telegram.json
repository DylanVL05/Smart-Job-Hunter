        "jsCode": "const items = $input.all();\nlet jobs = [];\nif (items.length === 1 && Array.isArray(items[0].json)) {\n  jobs = items[0].json;\n} else {\n  jobs = items.map(i => i.json);\n}\njobs = jobs.filter(j => j && j.id);\nreturn jobs.map(j => ({\n  json: {\n    title: j.position || j.title || '',\n    url: j.url || ('https://remoteok.com/remote-jobs/' + j.id),\n    description: (j.description || '').replace(/<[^>]+>/g, ' ').slice(0, 2000),\n    budget: (j.salary_min && j.salary_max) ? ('$' + j.salary_min + ' - $' + j.salary_max) : 'No especificado',\n    datePosted: j.date || '',\n    source: 'RemoteOK'\n  }\n}));"
      },
